<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.chatroom.ChatController">
   <children>
      <BorderPane layoutX="-1.0" layoutY="-1.0" prefHeight="601.0" prefWidth="200.0">
         <left>
            <VBox prefHeight="601.0" prefWidth="249.0" spacing="10.0" style="-fx-background-color: #2b2b2b;" BorderPane.alignment="CENTER">
               <children>
                  <Label prefHeight="47.0" prefWidth="149.0" text="User" textFill="#c9c9c9">
                     <padding>
                        <Insets left="20.0" right="20.0" top="20.0" />
                     </padding>
                     <font>
                        <Font size="15.0" />
                     </font>
                     <opaqueInsets>
                        <Insets />
                     </opaqueInsets>
                  </Label>
                  <Label fx:id="usernameLabel" text="loading..." textFill="WHITE">
                     <padding>
                        <Insets left="30.0" right="20.0" />
                     </padding>
                     <font>
                        <Font name="System Bold" size="19.0" />
                     </font>
                  </Label>
                  <Line endX="148.29287719726562" endY="-0.8283966779708862" startX="-100.0" stroke="#4d4d4d">
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </Line>
                  <Label prefHeight="32.0" prefWidth="149.0" text="Rooms" textFill="#c9c9c9">
                     <padding>
                        <Insets left="20.0" right="20.0" />
                     </padding>
                     <font>
                        <Font size="15.0" />
                     </font>
                     <opaqueInsets>
                        <Insets />
                     </opaqueInsets>
                  </Label>
                  <ListView fx:id="roomsList" prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: #2f2f2f;" />
                  <Line endX="149.5" startX="-100.0" stroke="#4d4d4d" />
                  <Label prefHeight="32.0" prefWidth="149.0" text="Direct messages" textFill="#c9c9c9">
                     <padding>
                        <Insets left="20.0" right="20.0" />
                     </padding>
                     <font>
                        <Font size="15.0" />
                     </font>
                     <opaqueInsets>
                        <Insets />
                     </opaqueInsets>
                  </Label>
                  <ListView fx:id="usersList" prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: #2f2f2f;" />
               </children>
            </VBox>
         </left>
         <right>
            <VBox prefHeight="616.0" prefWidth="518.0" style="-fx-background-color: #4d4d4d;" BorderPane.alignment="CENTER">
               <children>
                  <Label fx:id="currentRoomLabel" text="loading..." textFill="WHITE">
                     <VBox.margin>
                        <Insets left="20.0" top="20.0" />
                     </VBox.margin>
                     <font>
                        <Font size="27.0" />
                     </font>
                  </Label>
                  <Line endX="553.2929077148438" endY="-1.2426866292953491" startX="-100.0" stroke="#5e5e5e">
                     <VBox.margin>
                        <Insets top="20.0" />
                     </VBox.margin>
                  </Line>
                  <ScrollPane fitToWidth="true" prefHeight="507.0" prefWidth="655.0" VBox.vgrow="ALWAYS">
                    <content>
                      <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="456.0" prefWidth="639.0" style="-fx-background-color: #4d4d4d;">
                           <children>
                              <VBox fx:id="chatContainer" layoutX="-1.0" prefHeight="455.0" prefWidth="639.0" spacing="10.0">
                                 <padding>
                                    <Insets bottom="15.0" right="15.0" top="15.0" />
                                 </padding>
                              </VBox>
                           </children>
                        </AnchorPane>
                    </content>
                  </ScrollPane>
                  <HBox prefHeight="118.0" prefWidth="655.0" spacing="10.0">
                     <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                     </padding>
                     <children>
                        <TextField fx:id="messageField" prefHeight="37.0" prefWidth="487.0" style="-fx-background-color: #c9c9c9;" text="Write a message...." HBox.hgrow="ALWAYS">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </TextField>
                        <Button fx:id="sendButton" mnemonicParsing="false" onAction="#onSendMessage" prefHeight="32.0" prefWidth="87.0" text="Send">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </right>
      </BorderPane>
   </children>
</AnchorPane>
